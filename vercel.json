{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    { "src": "/projects/(linq-crm|signaldesk|orbit-watch-room)/?", "dest": "/projects/$1/index.html" },
    { "src": "/notes/(booking-workflows|source-linked-monitoring)/?", "dest": "/notes/$1/index.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/404.html", "status": 404 }
  ]
}
